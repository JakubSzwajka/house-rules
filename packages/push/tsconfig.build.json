{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@house-rules/application": ["../application/dist/index.d.ts"],
      "@house-rules/domain": ["../domain/dist/index.d.ts"],
      "@house-rules/migrations": ["../migrations/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/tests/**"]
}
