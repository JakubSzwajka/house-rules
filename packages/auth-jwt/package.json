{
  "name": "@house-rules/auth-jwt",
  "version": "0.1.0",
  "description": "Fills the House Rules Authenticator slot by verifying JWTs against a JWKS, with a Clerk preset.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "varlock run --path ../../ -- vitest run"
  },
  "peerDependencies": {
    "@house-rules/application": "0.2.0",
    "@house-rules/domain": "0.2.0",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@house-rules/application": "workspace:0.2.0",
    "@house-rules/domain": "workspace:0.2.0",
    "effect": "4.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakubSzwajka/house-rules.git",
    "directory": "packages/auth-jwt"
  },
  "bugs": {
    "url": "https://github.com/JakubSzwajka/house-rules/issues"
  },
  "homepage": "https://github.com/JakubSzwajka/house-rules",
  "dependencies": {
    "jose": "6.2.12"
  }
}
