{
  "name": "@house-rules/push-node",
  "version": "0.1.0",
  "description": "Optional Node Web Push sender cartridge for the PushSender port.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakubSzwajka/house-rules.git",
    "directory": "packages/push-node"
  },
  "bugs": {
    "url": "https://github.com/JakubSzwajka/house-rules/issues"
  },
  "homepage": "https://github.com/JakubSzwajka/house-rules",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "varlock run --path ../../ -- vitest run"
  },
  "dependencies": {
    "web-push": "3.6.7"
  },
  "peerDependencies": {
    "@house-rules/push": "0.1.1",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@house-rules/domain": "workspace:0.2.1",
    "@house-rules/push": "workspace:0.1.1",
    "@types/node": "24.19.1",
    "@types/web-push": "3.6.4",
    "effect": "4.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
