          "(?:^|/)node_modules/effect/(?:[^/]+/|)unstable/sql(?:[/.]|$)",
          "(?:^|/)node_modules/effect/(?:[^/]+/|)sql(?:[/.]|$)",
          "(?:^|/)node_modules/@effect/sql-[^/]*/",
          "(?:^|/)node_modules/@effect/platform-[^/]*/"
        ]
      }
    }
  ],
  "options": {
    "parser": "swc",
    "exclude": {
      "path": "^(?!.*node_modules/)(?:|.*/)(?:dist|coverage|generated|[.]turbo|[.]agent_sources|[.]next)(?:/|$)"
    },
    "doNotFollow": {
      "path": "(?:^|/)node_modules(?:/|$)"
