{
  "forbidden": [
    {
      "name": "no-cycles",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#no-cycles",
      "from": {},
      "to": {
        "circular": true
      }
    },
    {
      "name": "packages-do-not-import-apps",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#packages-do-not-import-apps",
      "from": {
        "path": "^packages/"
      },
      "to": {
        "path": "^apps/"
      }
    },
    {
      "name": "apps-do-not-import-other-apps",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#apps-do-not-import-other-apps",
      "from": {
        "path": "^(apps/[^/]+)/"
      },
      "to": {
        "path": "^apps/",
        "pathNot": "^$1/"
      }
    },
    {
      "name": "packages-imported-by-name",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#packages-imported-by-name",
      "from": {
        "path": "^((?:apps|packages)/[^/]+)/"
      },
      "to": {
        "path": "^packages/",
        "pathNot": "^$1/",
        "dependencyTypes": [
          "local"
        ]
      }
    },
    {
      "name": "packages-public-entry-only",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#packages-public-entry-only",
      "from": {
        "path": "^((?:apps|packages)/[^/]+)/"
      },
      "to": {
        "path": "^packages/[^/]+/(?!(?:src/index[.]ts|src/contract[.]ts)$)",
        "pathNot": "^$1/"
      }
    },
    {
      "name": "contract-entry-is-browser-safe",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#contract-entry-is-browser-safe",
      "from": {
        "path": "^packages/[^/]+/src/contract[.]ts$"
      },
      "to": {
        "reachable": true,
        "pathNot": [
          "^packages/[^/]+/(?!src/adapters(?:/|$)|(?:src/index[.]ts|src/facade[.]ts|src/storage[.]ts)$|src/(?:.*/|)(?:tests?|__tests__)/|.*[.](?:test|spec)[.][^/]+$)src/",
          "(?:^|/)node_modules/effect/dist/(?:index|[A-Z][A-Za-z0-9]*|unstable/http/(?:index|[A-Z][A-Za-z0-9]*))[.]js$",
          "(?:^|/)node_modules/(?:@house-rules/capability)/(?:src/contract[.]ts|dist/contract[.](?:js|d[.]ts))$"
        ]
      }
    },
    {
      "name": "delivery-does-not-import-server",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#delivery-does-not-import-server",
      "from": {
        "path": "^apps/[^/]+/src/app(?:/|$)"
      },
      "to": {
        "path": "^apps/[^/]+/src/server(?:/|$)",
        "reachable": true
      }
    },
    {
      "name": "server-does-not-import-delivery",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#server-does-not-import-delivery",
      "from": {
        "path": "^apps/[^/]+/src/server(?:/|$)"
      },
      "to": {
        "path": "^apps/[^/]+/src/app(?:/|$)",
        "reachable": true
      }
    },
    {
      "name": "use-cases-do-not-import-outer-layers",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#use-cases-do-not-import-outer-layers",
      "from": {
        "path": "^apps/[^/]+/src/use-cases(?:/|$)"
      },
      "to": {
        "path": [
          "^apps/[^/]+/src/app(?:/|$)",
          "^apps/[^/]+/src/server(?:/|$)"
        ],
        "reachable": true
      }
    },
    {
      "name": "composition-imports-packages-only",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#composition-imports-packages-only",
      "from": {
        "path": "^apps/[^/]+/src/composition(?:/|$)"
      },
      "to": {
        "path": "^apps/[^/]+/",
        "pathNot": "^apps/[^/]+/src/composition(?:/|$)"
      }
    },
    {
      "name": "use-cases-do-not-import-composition",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#use-cases-do-not-import-composition",
      "from": {
        "path": "^apps/[^/]+/src/use-cases(?:/|$)",
        "pathNot": "(?:^|/)(?:tests?|__tests__)(?:/|$)|[.](?:test|spec)[.][^/]+$"
      },
      "to": {
        "path": "^apps/[^/]+/src/composition(?:/|$)",
        "reachable": true
      }
    },
    {
      "name": "no-unresolved-deep-package-imports",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#no-unresolved-deep-package-imports",
      "from": {},
      "to": {
        "path": "^@hosti/[^/]+/.+",
        "couldNotResolve": true
      }
    },
    {
      "name": "production-does-not-import-tests",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#production-does-not-import-tests",
      "from": {
        "path": "^(?:apps|packages)/[^/]+/src(?:/|$)",
        "pathNot": "(?:^|/)(?:tests?|__tests__)(?:/|$)|[.](?:test|spec)[.][^/]+$"
      },
      "to": {
        "path": "(?:^|/)(?:tests?|__tests__)(?:/|$)|[.](?:test|spec)[.][^/]+$"
      }
    },
    {
      "name": "tests-live-in-tests-dir",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#tests-live-in-tests-dir",
      "module": {
        "path": "^(?:apps|packages)/[^/]+/.*[.](?:test|spec)[.][^/]+$",
        "pathNot": "^(?:apps|packages)/[^/]+/src/(?:tests|.*/tests)/[^/]+[.](?:test|spec)[.][^/]+$",
        "numberOfDependentsLessThan": 100
      },
      "from": {}
    },
    {
      "name": "tests-do-not-import-internals",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#tests-do-not-import-internals",
      "from": {
        "path": "(?:^|/)(?:tests?|__tests__)(?:/|$)|[.](?:test|spec)[.][^/]+$"
      },
      "to": {
        "path": "^packages/[^/]+/src/internal(?:/|$)"
      }
    },
    {
      "name": "no-unresolved-imports",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#no-unresolved-imports",
      "from": {
        "pathNot": "^apps/[^/]+/(?:next-env[.]d[.]ts)$"
      },
      "to": {
        "couldNotResolve": true
      }
    },
    {
      "name": "app-code-in-layers",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#app-code-in-layers",
      "module": {
        "path": "^apps/[^/]+/src/",
        "pathNot": [
          "^apps/[^/]+/src/(?:app|server|use-cases|composition)/",
          "^apps/[^/]+/src/(?:main[.]ts|index[.]ts|proxy[.]ts|instrumentation[.]ts)$",
          "(?:^|/)(?:tests?|__tests__)(?:/|$)|[.](?:test|spec)[.][^/]+$"
        ],
        "numberOfDependentsLessThan": 100
      },
      "from": {}
    },
    {
      "name": "use-cases-do-not-import-use-cases",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#use-cases-do-not-import-use-cases",
      "from": {
        "path": "^(apps/[^/]+/src/use-cases/[^/]+)",
        "pathNot": "(?:^|/)(?:tests?|__tests__)(?:/|$)|[.](?:test|spec)[.][^/]+$"
      },
      "to": {
        "path": "^apps/[^/]+/src/use-cases/[^/]+",
        "pathNot": [
          "^$1(?:/|$)",
          "(?:^|/)(?:tests?|__tests__)(?:/|$)|[.](?:test|spec)[.][^/]+$"
        ],
        "reachable": true
      }
    },
    {
      "name": "no-ownerless-files",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#no-ownerless-files",
      "module": {
        "path": [
          "^(?:apps|packages)/(?:.*/)?(?:utils|helpers|misc)(?:[.][^/]*)?(?:/|$)",
          "^packages/[^/]+/(?:.*/)?(?:[tT][yY][pP][eE][sS]|[mM][oO][dD][eE][lL][sS]|[sS][cC][hH][eE][mM][aA][sS]|[dD][rR][aA][fF][tT][sS]|[eE][rR][rR][oO][rR][sS]|[vV][aA][lL][iI][dD][aA][tT][eE]|[vV][aA][lL][iI][dD][aA][tT][iI][oO][nN]|[cC][oO][nN][sS][tT][aA][nN][tT][sS]|[iI][nN][tT][eE][rR][fF][aA][cC][eE][sS]|[iI][nN][tT][eE][rR][nN][aA][lL])(?:[.][^/]*)?(?:/|$)"
        ],
        "numberOfDependentsLessThan": 100
      },
      "from": {}
    },
    {
      "name": "package-root-files",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#package-root-files",
      "module": {
        "path": "^packages/[^/]+/src/[^/]+$",
        "pathNot": [
          "^packages/[^/]+/src/(?:index[.]ts|facade[.]ts|storage[.]ts)$",
          "(?:^|/)(?:tests?|__tests__)(?:/|$)|[.](?:test|spec)[.][^/]+$",
          "^packages/[^/]+/src/contract[.]ts$"
        ],
        "numberOfDependentsLessThan": 100
      },
      "from": {}
    },
    {
      "name": "domain-does-not-import-adapters",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#domain-does-not-import-adapters",
      "from": {
        "path": "^(packages/[^/]+)/src/",
        "pathNot": [
          "^packages/[^/]+/src/adapters(?:/|$)",
          "^packages/[^/]+/src/index[.]ts$",
          "^packages/[^/]+/src/facade[.]ts$"
        ]
      },
      "to": {
        "path": "^$1/src/adapters(?:/|$)",
        "pathNot": "^$1/src/adapters/tests(?:/|$)"
      }
    },
    {
      "name": "domain-does-not-import-adapters",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#domain-does-not-import-adapters",
      "from": {
        "path": "^(packages/[^/]+)/src/",
        "pathNot": [
          "^packages/[^/]+/src/adapters(?:/|$)",
          "^packages/[^/]+/src/index[.]ts$",
          "^packages/[^/]+/src/facade[.]ts$",
          "(?:^|/)(?:tests?|__tests__)(?:/|$)|[.](?:test|spec)[.][^/]+$"
        ]
      },
      "to": {
        "path": "^$1/src/adapters/tests(?:/|$)"
      }
    },
    {
      "name": "subjects-do-not-import-package-root",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#subjects-do-not-import-package-root",
      "from": {
        "path": "^(packages/[^/]+)/src/[^/]+/",
        "pathNot": [
          "^packages/[^/]+/src/adapters(?:/|$)",
          "^packages/[^/]+/src/(?:tests?|__tests__)(?:/|$)",
          "(?:^|/)(?:tests?|__tests__)(?:/|$)|[.](?:test|spec)[.][^/]+$"
        ]
      },
      "to": {
        "path": "^$1/(?:src/index[.]ts|src/facade[.]ts|src/contract[.]ts)$"
      }
    },
    {
      "name": "adapter-imports-only-in-adapters",
      "severity": "error",
      "comment": "See https://stack.kubaszwajka.com/rules/#adapter-imports-only-in-adapters",
      "from": {
        "path": "^packages/[^/]+/src/",
        "pathNot": [
          "^packages/[^/]+/src/adapters(?:/|$)"
        ]
      },
      "to": {
        "path": [
          "(?:^|/)node_modules/effect/(?:[^/]+/|)unstable/sql(?:[/.]|$)",
          "(?:^|/)node_modules/@effect/sql-[^/]*/",
          "(?:^|/)node_modules/@effect/platform-[^/]*/"
        ]
      }
    }
  ],
  "options": {
    "parser": "swc",
    "exclude": {
      "path": "^(?!.*node_modules/)(?:|.*/)(?:dist|coverage|generated|[.]turbo|[.]agent_sources|[.]next)(?:/|$)"
    },
    "doNotFollow": {
      "path": "(?:^|/)node_modules(?:/|$)"
    },
    "skipAnalysisNotInRules": true,
    "tsPreCompilationDeps": "specify",
    "enhancedResolveOptions": {
      "exportsFields": [
        "exports"
      ],
      "conditionNames": [
        "import",
        "require",
        "node",
        "default"
      ]
    }
  }
}
