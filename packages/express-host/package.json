{
  "name": "@house-rules/express-host",
  "version": "0.1.0",
  "description": "An optional Express host for a streaming Web fetch handler.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@house-rules/node-host": "workspace:0.2.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakubSzwajka/house-rules.git",
    "directory": "packages/express-host"
  },
  "bugs": {
    "url": "https://github.com/JakubSzwajka/house-rules/issues"
  },
  "homepage": "https://github.com/JakubSzwajka/house-rules"
}
