{
  "name": "@house-rules/call-audit",
  "version": "0.5.0",
  "description": "Audit every capability call: one log line per call, a row per call in a table, or an in-memory log for tests.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "AGENTS.md",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "houseRules": {
    "migrations": "migrations"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "varlock run --path ../../ -- vitest run"
  },
  "peerDependencies": {
    "@house-rules/capability": "0.16.0",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@effect/sql-pg": "4.0.3",
    "@effect/vitest": "4.0.3",
    "@house-rules/capability": "workspace:0.16.0",
    "@house-rules/migrations": "workspace:0.3.0",
    "effect": "4.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakubSzwajka/house-rules.git",
    "directory": "packages/call-audit"
  },
  "bugs": {
    "url": "https://github.com/JakubSzwajka/house-rules/issues"
  },
  "homepage": "https://github.com/JakubSzwajka/house-rules"
}
