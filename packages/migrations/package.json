{
  "name": "@house-rules/migrations",
  "version": "0.3.0",
  "description": "Run SQL migrations for many modules, each with its own folder and its own history table.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "varlock run --path ../../ -- vitest run"
  },
  "peerDependencies": {
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.3",
    "@effect/sql-pg": "4.0.3",
    "@effect/vitest": "4.0.3",
    "effect": "4.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakubSzwajka/house-rules.git",
    "directory": "packages/migrations"
  },
  "bugs": {
    "url": "https://github.com/JakubSzwajka/house-rules/issues"
  },
  "homepage": "https://github.com/JakubSzwajka/house-rules"
}
