{
  "name": "@house-rules/site",
  "version": "0.0.0",
  "private": true,
  "description": "The house-rules docs site, for people and agents.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.ts",
    "dev": "node scripts/generate.ts && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/generate.ts && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/llms.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test \"scripts/tests/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@house-rules/rules": "workspace:0.6.0",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
