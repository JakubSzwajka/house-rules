---
// The parts list box on a generated rule page: the rule's row from the rules table in packages/rules/README.md,
// plus the page's own Field | Value rows. The page's table is hidden by content.css, so this box is the one metadata block.
interface Props {
  readonly part: {
    readonly id: string;
    readonly catches: string;
    readonly facts: readonly (readonly [string, string])[];
  };
}

const { part } = Astro.props;
// Rule ids such as no-cycles or noNonNullAssertion are code; names such as "Exact pins" are prose.
const isCodeName = /^[a-z][\w-]*$/.test(part.id);

// Cells use backticks for code and [text](url) for links, and nothing else, so escape the text and turn those into tags.
const escape = (text: string): string =>
  text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
const inline = (cell: string): string =>
  escape(cell)
    .replace(
      /\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g,
      (_match, text: string, href: string) => `<a href="${href}">${text}</a>`,
    )
    .replace(/`([^`]+)`/g, (_match, code: string) => `<code>${code}</code>`);

const WIDE = new Set(["Source", "Docs"]);
const narrow = part.facts.filter(([name]) => !WIDE.has(name));
const wide = part.facts.filter(([name]) => WIDE.has(name));
---

<section class="parts" aria-labelledby="hr-parts-title">
  <h2 id="hr-parts-title" class="head">Parts list</h2>
  <dl>
    <div>
      <dt>Rule</dt>
      <dd>{isCodeName ? <code>{part.id}</code> : part.id}</dd>
    </div>
    {
      narrow.map(([name, value]) => (
        <div>
          <dt>{name}</dt>
          <dd set:html={inline(value)} />
        </div>
      ))
    }
    <div class="wide">
      <dt>Catches</dt>
      <dd set:html={inline(part.catches)} />
    </div>
    {
      wide.map(([name, value]) => (
        <div class="wide">
          <dt>{name}</dt>
          <dd set:html={inline(value)} />
        </div>
      ))
    }
  </dl>
</section>

<style>
  .parts {
    margin-top: 1.25rem;
    max-width: 46rem;
    border: var(--hr-line-width) solid var(--hr-line);
    border-radius: var(--hr-radius);
    background: var(--hr-paper);
    overflow: hidden;
  }

  .head {
    margin: 0;
    padding: 0.4rem 1rem;
    background: var(--hr-accent);
    border-bottom: var(--hr-line-width) solid var(--hr-on-accent);
    color: var(--hr-on-accent);
    font: 700 0.78rem / 1.3 var(--hr-font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Cells wrap to the width; the negative end margins push the last cell borders under the box edge. */
  dl {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -1px -1px 0;
  }

  dl > div {
    flex: 1 1 10rem;
    margin: 0;
    padding: 0.6rem 1rem 0.7rem;
    border-inline-end: 1px solid var(--hr-hairline);
    border-bottom: 1px solid var(--hr-hairline);
  }

  .wide {
    flex-basis: 100%;
  }

  dt {
    font: 700 0.72rem / 1.3 var(--hr-font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hr-ink-soft);
  }

  dd {
    margin: 0.2rem 0 0;
    color: var(--hr-ink-strong);
    line-height: 1.45;
    overflow-wrap: break-word;
  }

  .parts :global(code) {
    font-family: var(--hr-font-mono);
    font-size: 0.9em;
    background: var(--hr-code-bg);
    padding: 0.05em 0.3em;
    border-radius: 3px;
  }

  .parts :global(a) {
    color: var(--hr-link);
    text-decoration-color: var(--hr-link-line);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .parts :global(a:hover) {
    background: var(--hr-accent);
    color: var(--hr-on-accent);
  }

  .parts :global(a:hover code) {
    background: none;
  }
</style>
