---
// Hero override for the splash home: the title and actions from the frontmatter, plus the queue at the exact-pins door.
import { LinkButton } from "@astrojs/starlight/components";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};

// Real specs, judged by the house-rules-pins rules in packages/rules/docs/pins.md.
const queue = [
  { spec: "^1.4.2", admitted: false },
  { spec: "4.0.0-rc.1", admitted: true },
  { spec: "latest", admitted: false },
  { spec: "workspace:0.0.0", admitted: true },
  { spec: "~2.1.0", admitted: false },
  { spec: "github:owner/repo#main", admitted: false },
];
---

<div class="door-hero">
  <div class="copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    <code class="cmd">gh repo create &lt;name&gt; --template JakubSzwajka/house-rules</code>
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>

  <figure class="queue">
    <svg class="gate" viewBox="0 0 400 120" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="hr-brass" x1="0" x2="1">
          <stop offset="0" style="stop-color: var(--hr-brass-deep)" />
          <stop offset="0.45" style="stop-color: var(--hr-brass-hi)" />
          <stop offset="1" style="stop-color: var(--hr-brass-deep)" />
        </linearGradient>
      </defs>
      <path class="rope-shade" d="M44 30 Q 200 118 356 30" />
      <path class="rope" d="M44 28 Q 200 116 356 28" />
      <g fill="url(#hr-brass)">
        <circle cx="44" cy="22" r="13" />
        <rect x="40" y="34" width="8" height="70" />
        <ellipse cx="44" cy="106" rx="26" ry="7" />
        <circle cx="356" cy="22" r="13" />
        <rect x="352" y="34" width="8" height="70" />
        <ellipse cx="356" cy="106" rx="26" ry="7" />
      </g>
    </svg>
    <ul aria-label="Dependency specs at the exact-pins door">
      {
        queue.map(({ spec, admitted }) => (
          <li class="ticket">
            <code>{spec}</code>
            <span class:list={["hr-stamp", admitted ? "hr-stamp--ok" : "hr-stamp--no"]}>
              {admitted ? "On the list" : "Turned away"}
            </span>
          </li>
        ))
      }
    </ul>
    <figcaption>Sample specs at the <a href="/rules/node/exact-pins/">exact-pins</a> door.</figcaption>
  </figure>
</div>

<style>
  .door-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding-block: clamp(2rem, 1rem + 6vmin, 5rem) 1.5rem;
  }

  h1 {
    font: 400 clamp(2.8rem, 1rem + 5.6vw, 5.6rem) / 1 var(--hr-font-display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--hr-heading);
    margin: 0;
    text-wrap: balance;
  }

  h1 :global(em) {
    display: block;
    font-style: normal;
    color: var(--hr-hero-em);
  }

  .tagline {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
    line-height: 1.55;
    color: var(--hr-text);
    max-width: 36rem;
    margin: 1.5rem 0;
  }

  .cmd {
    display: block;
    background: var(--hr-bg-deep);
    color: var(--hr-text);
    font: 400 0.92rem / 1.4 var(--hr-font-mono);
    padding: 0.8rem 1rem;
    border-radius: 3px;
    margin-bottom: 1.5rem;
    overflow-x: auto;
    white-space: pre;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .queue {
    margin: 0;
    padding: 0 1rem;
  }

  .gate {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: -0.6rem;
  }

  .rope-shade,
  .rope {
    fill: none;
    stroke-linecap: round;
  }

  .rope-shade {
    stroke: var(--hr-rope-shade);
    stroke-width: 13;
  }

  .rope {
    stroke: var(--hr-rope);
    stroke-width: 9;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .ticket {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    background: var(--hr-ticket);
    color: var(--hr-ink);
    padding: 0.8rem 1.4rem;
    border-radius: 3px;
    box-shadow: var(--hr-shadow-ticket);
  }

  .ticket code {
    font: 600 1rem / 1.2 var(--hr-font-mono);
    white-space: nowrap;
    background: none;
    padding: 0;
    color: var(--hr-ink);
    overflow-wrap: anywhere;
  }

  .ticket::before,
  .ticket::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: -0.55rem;
    border-radius: 50%;
    background: var(--sl-color-bg);
  }

  .ticket::before {
    left: -0.55rem;
  }

  .ticket::after {
    right: -0.55rem;
  }

  .ticket:nth-child(odd) {
    margin-right: 1.5rem;
  }

  .ticket:nth-child(even) {
    margin-left: 1.5rem;
  }

  figcaption {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--hr-muted);
  }

  figcaption a {
    color: var(--hr-link);
  }

  /* the one authored moment: the doorman stamps each ticket in turn */
  @media (prefers-reduced-motion: no-preference) {
    .ticket .hr-stamp {
      animation: thump 0.45s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }
    .ticket:nth-child(1) .hr-stamp {
      animation-delay: 0.3s;
    }
    .ticket:nth-child(2) .hr-stamp {
      animation-delay: 0.6s;
    }
    .ticket:nth-child(3) .hr-stamp {
      animation-delay: 0.9s;
    }
    .ticket:nth-child(4) .hr-stamp {
      animation-delay: 1.2s;
    }
    .ticket:nth-child(5) .hr-stamp {
      animation-delay: 1.5s;
    }
    .ticket:nth-child(6) .hr-stamp {
      animation-delay: 1.8s;
    }
    @keyframes thump {
      from {
        opacity: 0;
        scale: 2.2;
      }
    }
  }

  @media (max-width: 60rem) {
    .door-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .queue {
      padding: 0 0.5rem;
    }
    .ticket {
      padding: 0.7rem 1.2rem;
    }
    .ticket code {
      white-space: normal;
    }
    .ticket:nth-child(odd) {
      margin-right: 0.5rem;
    }
    .ticket:nth-child(even) {
      margin-left: 0.5rem;
    }
  }
</style>
