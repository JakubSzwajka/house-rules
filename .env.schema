# Environment schema for this project. This file is checked in.
#
# - Declare every environment variable the code reads here.
# - Never put a secret value in this file. Secrets default to @sensitive.
# - Mark a non-secret variable with @sensitive=false.
# - Put local values, including secrets, in .env.local. Git ignores it.
# - Give every required variable a default, or CI (which has no .env.local)
#   fails `pnpm env:check`.
#
# Validate: pnpm env:check
# Run a command with the values injected: npx varlock run -- <cmd>
#
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Example non-secret setting. Replace it with the project's real variables.
# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Listen port for an app served locally on Node, such as the booking server.
# Node assigns a free port when this is 0.
# @type=number
# @sensitive=false
PORT=3000

# Clerk sign-in for the booking server; unset means dev tokens.
# @type=url
# @sensitive=false
CLERK_ISSUER=

# Clerk's PEM public key for networkless verification; unset fetches the JWKS.
# @sensitive=false
CLERK_JWT_KEY=

# Comma-separated origins Clerk tokens may come from (the azp claim); unset or empty skips the check.
# @sensitive=false
CLERK_AUTHORIZED_PARTIES=

# Where the booking CLI sends calls.
# @type=url
# @sensitive=false
BOOKING_URL=http://localhost:3000

# The dev token the booking CLI sends; a fixed local-only value.
# @sensitive=false
BOOKING_TOKEN=ann-token

