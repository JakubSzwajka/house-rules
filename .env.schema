# Environment schema for this project. This file is checked in.
#
# - Declare every environment variable the code reads here.
# - Never put a secret value in this file. Secrets default to @sensitive.
# - Mark a non-secret variable with @sensitive=false.
# - Put local values, including secrets, in .env.local. Git ignores it.
# - Give every required variable a default, or CI (which has no .env.local)
#   fails `pnpm env:check`.
#
# Validate: pnpm env:check
# Run a command with the values injected: npx varlock run -- <cmd>
#
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Example non-secret setting. Replace it with the project's real variables.
# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Reference API listen port. Node assigns a free port when this is 0.
# @type=number
# @sensitive=false
PORT=3000

# The app's canonical public HTTP(S) origin. Cookie writes behind a TLS proxy
# check it, MCP names `<origin>/mcp` as the token audience and resource, and
# the accounts issuer defaults to it. Empty uses Host for cookie writes, and MCP
# refuses every call (503).
# @sensitive=false
APP_ORIGIN=

# The reference API's own sign-in: email and password accounts. A private EC
# P-256 JWK, as JSON, that signs the tokens. Put it only in .env.local. Make one:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign']).then(k=>crypto.subtle.exportKey('jwk',k.privateKey)).then(j=>console.log(JSON.stringify(j)))"
# Empty: a temporary key and a loud log line, so every token dies on restart.
# The API refuses to start without it when NODE_ENV is production.
# @sensitive
ACCOUNTS_SIGNING_KEY=

# The `iss` of the reference API's own sign-in tokens. Empty: the origin of
# APP_ORIGIN when set, else http://localhost:<PORT>.
# @sensitive=false
ACCOUNTS_ISSUER=

# MCP only: the external OAuth authorization server MCP clients get tokens
# from, as their exact `iss`. Its public keys load from
# <issuer>/.well-known/jwks.json, and /.well-known/oauth-protected-resource
# names it. Web sign-in never uses it: a login there is another identity.
# Empty, or APP_ORIGIN empty: MCP refuses every call (503).
# @sensitive=false
MCP_AUTH_ISSUER=

# The built web page the reference API serves beside /api and /mcp, one origin.
# Empty: dist/web beside the bundle when `build` wrote it, else API only.
# Set: that folder, which must hold index.html, or the API refuses to start.
# @sensitive=false
WEB_ROOT=

# Node's environment name. The reference API reads it only to refuse to start
# in production without ACCOUNTS_SIGNING_KEY.
# @sensitive=false
NODE_ENV=

# Postgres for the reference API. Set: Postgres adapters, the SQL unit of work
# and call-audit's table, and main.ts migrates migrations.json before serving.
# Empty: everything in memory.
# @sensitive
DATABASE_URL=

# Test database server. Test suites that need Postgres create and drop their
# own throwaway databases through this admin URL, named with the namespace.
# The defaults point at the docker-compose.yml service and the CI service, and
# the password is a local test value, not a secret. Start it: docker compose up -d
# @sensitive=false
TEST_DATABASE_ADMIN_URL=postgres://house_rules:house_rules@127.0.0.1:55435/postgres

# @sensitive=false
TEST_DATABASE_NAMESPACE=house_rules_local
