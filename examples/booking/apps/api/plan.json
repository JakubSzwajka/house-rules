  "features": [
    {
      "name": "accept_invitation",
      "path": "src/features/accept-invitation/index.ts",
      "permission": null,
      "transactional": true,
      "edges": [
        "Party.acceptInvitation",
        {
          "target": "Party.assignRole",
          "reason": "role delegated by organisation invitation"
        }
      ]
    },
    {
      "name": "assign_role",
      "path": "src/features/assign-role/index.ts",
      "permission": null,
      "edges": ["Party.assignRole"]
    },
    {
      "name": "cancel_booking",
      "path": "src/features/cancel-booking/index.ts",
      "permission": null,
      "edges": [
        "Bookings.cancel",
        {
          "target": "Billing.refund",
          "reason": "refund after cancel"
        }
      ]
    },
    {
      "name": "change_password",
      "path": "src/features/change-password/index.ts",
      "permission": null,
      "transactional": true,
      "edges": ["Identity.changePassword"]
    },
    {
      "name": "create_invitation",
      "path": "src/features/create-invitation/index.ts",
      "permission": null,
      "transactional": true,
      "edges": ["Party.createInvitation"]
    },
    {
      "name": "create_organisation",
      "path": "src/features/create-organisation/index.ts",
      "permission": null,
      "transactional": true,
      "edges": [
        "Party.createOrganisation",
        {
          "target": "Party.assignRole",
          "reason": "creator of organisation"
        }
      ]
    },
    {
      "name": "define_role",
      "path": "src/features/define-role/index.ts",
      "permission": null,
      "edges": ["Party.defineRole"]
    },
    {
      "name": "delete_role",
      "path": "src/features/delete-role/index.ts",
      "permission": null,
      "transactional": true,
      "edges": ["Party.deleteRole"]
    },
    {
      "name": "due_payments",
      "path": "src/features/due-payments/index.ts",
      "permission": null,
      "readOnly": true,
      "start": {
        "reason": "nightly cleanup",
        "startedBy": "schedule:nightly-cleanup"
      },
      "edges": ["Billing.duePayments"]
    },
    {
      "name": "expire_payment",
      "path": "src/features/expire-payment/index.ts",
      "permission": null,
      "start": {
        "reason": "nightly cleanup",
        "startedBy": "schedule:nightly-cleanup"
      },
      "edges": ["Billing.expireOne"]
    },
    {
      "name": "first_sign_in",
      "path": "src/features/first-sign-in/index.ts",
      "permission": null,
      "start": {
        "reason": "new login",
        "startedBy": "hook:new-login"
      },
      "edges": [
        "Party.createPerson",
        "Identity.bindLogin",
        {
          "target": "Party.assignRole",
          "reason": "default role on first sign-in"
        }
      ]
    },
    {
      "name": "list_invitations",
      "path": "src/features/list-invitations/index.ts",
      "permission": null,
      "readOnly": true,
      "edges": ["Party.listInvitations"]
    },
    {
      "name": "list_members",
      "path": "src/features/list-members/index.ts",
      "permission": null,
      "readOnly": true,
      "edges": ["Party.listMembers"]
    },
    {
      "name": "list_people",
