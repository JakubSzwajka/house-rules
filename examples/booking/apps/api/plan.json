    {
      "name": "make_booking",
      "path": "src/features/make-booking/index.ts",
      "permission": null,
      "edges": ["Bookings.book", "Billing.initPayment"]
    },
    {
      "name": "my_activity",
      "path": "src/features/my-activity/index.ts",
      "permission": null,
      "readOnly": true,
      "edges": ["AuditTrail.mine"]
    },
    {
      "name": "my_bookings",
      "path": "src/features/my-bookings/index.ts",
      "permission": null,
