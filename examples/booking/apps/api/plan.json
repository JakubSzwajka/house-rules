    },
    {
      "name": "show_booking",
      "path": "src/features/show-booking/index.ts",
      "permission": null,
      "readOnly": true,
      "edges": ["Bookings.get"]
    },
    {
      "name": "sign_in",
      "path": "src/features/sign-in/index.ts",
      "permission": null,
      "transactional": true,
      "start": {
        "reason": "public sign_in",
        "startedBy": "public sign_in"
      },
      "edges": ["Identity.signIn"]
    },
    {
      "name": "sign_out",
      "path": "src/features/sign-out/index.ts",
      "permission": null
    },
    {
      "name": "sign_up",
      "path": "src/features/sign-up/index.ts",
      "permission": null,
      "transactional": true,
      "start": {
        "reason": "public sign_up",
        "startedBy": "public sign_up"
      },
      "edges": ["Identity.signUp"]
    }
  ],
  "ways": [
    {
      "name": "mcp",
      "protocol": "mcp",
      "path": "/mcp",
      "mean": "elicitation",
      "source": "src/ways-in/mcp/way.ts",
      "features": ["my_bookings", "show_booking"]
    },
    {
      "name": "new-login",
      "protocol": "hook",
      "slot": "@house-rules/identity/FirstSignIn",
      "mean": "allow",
      "source": "src/ways-in/hooks/first-sign-in.ts",
      "features": ["first_sign_in"]
    },
    {
      "name": "nightly-cleanup",
      "protocol": "schedule",
      "clock": {
        "cron": "0 3 * * *",
        "timeZone": "UTC"
      },
      "mean": "allow",
      "source": "src/ways-in/schedules/nightly-cleanup.ts",
      "features": ["due_payments", "expire_payment"]
    },
    {
      "name": "web",
      "protocol": "http",
      "path": "/api",
      "mean": "allow",
      "source": "src/ways-in/web/way.ts",
      "features": [
        "accept_invitation",
        "assign_role",
        "cancel_booking",
        "change_password",
        "create_invitation",
        "create_organisation",
        "define_role",
        "delete_role",
        "list_invitations",
        "list_members",
        "list_people",
        "list_permissions",
        "list_roles",
        "make_booking",
        "my_activity",
        "my_bookings",
        "my_organisations",
        "my_profile",
        "recent_audit",
        "remove_member",
        "revoke_invitation",
        "revoke_role",
        "show_booking",
        "sign_in",
        "sign_out",
        "sign_up"
      ],
      "public": ["sign_in", "sign_up"]
    }
  ],
  "plugs": [
    {
      "name": "CallAudit.record",
      "package": "@house-rules/call-audit",
      "fills": "Record"
    },
    {
      "name": "Identity.who",
      "package": "@house-rules/identity",
      "fills": "Who",
      "ways": ["mcp", "web"]
    },
    {
      "name": "Mean.allow",
      "package": "@house-rules/application",
      "fills": "Mean",
      "ways": ["new-login", "nightly-cleanup", "web"]
    },
    {
      "name": "Mean.elicitation",
      "package": "@house-rules/application",
      "fills": "Mean",
      "ways": ["mcp"]
    },
    {
      "name": "Party.may",
      "package": "@house-rules/party",
      "fills": "May"
    },
    {
      "name": "hook:new-login",
      "fills": "@house-rules/identity/FirstSignIn",
      "ways": ["new-login"]
    }
  ]
}
