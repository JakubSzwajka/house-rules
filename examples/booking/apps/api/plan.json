{
  "modules": [
    {
      "name": "audit-trail",
      "service": "@example/api/read-models/audit-trail/AuditTrail",
      "kind": "read-model",
      "package": "@example/api",
      "path": "src/read-models/audit-trail",
      "operations": [
        {
          "name": "AuditTrail.mine",
          "permission": null,
          "readOnly": true
        },
        {
          "name": "AuditTrail.recent",
          "permission": "audit:read",
          "readOnly": true
        }
      ]
    },
    {
      "name": "billing",
      "service": "@example/billing/Billing",
      "kind": "package",
      "package": "@example/billing",
      "path": "examples/booking/packages/billing",
      "operations": [
        {
          "name": "Billing.duePayments",
          "permission": "billing:expire",
          "readOnly": true
        },
        {
          "name": "Billing.expireOne",
          "permission": "billing:expire",
          "transactional": true
        },
        {
          "name": "Billing.initPayment",
          "permission": "billing:charge",
          "transactional": true
        },
        {
          "name": "Billing.refund",
          "permission": "billing:refund",
          "destructive": true,
          "transactional": true
        }
      ]
    },
    {
      "name": "bookings",
      "service": "@example/bookings/Bookings",
      "kind": "package",
      "package": "@example/bookings",
      "path": "examples/booking/packages/bookings",
      "operations": [
        {
          "name": "Bookings.book",
          "permission": "bookings:write",
          "transactional": true,
          "edges": ["Party.isRelated", "Party.canAdminOrganisation"]
        },
        {
          "name": "Bookings.cancel",
          "permission": "bookings:cancel",
          "destructive": true,
          "transactional": true,
          "needsApproval": true,
          "edges": ["Party.isRelated", "Party.canAdminOrganisation"]
        },
        {
          "name": "Bookings.get",
          "permission": "bookings:read",
          "readOnly": true,
          "edges": ["Party.isRelated"]
        }
      ]
    },
    {
      "name": "identity",
      "service": "identity",
      "kind": "package",
      "package": "@house-rules/identity",
      "path": "packages/identity",
      "operations": [
        {
          "name": "Identity.bindLogin",
          "permission": "identity:bind",
          "transactional": true
        },
        {
          "name": "Identity.changePassword",
          "permission": "identity:update",
          "transactional": true
        },
        {
          "name": "Identity.endSessions",
          "permission": "identity:sessions-end",
          "transactional": true,
          "destructive": true,
          "needsApproval": true
        },
        {
          "name": "Identity.issueToken",
          "permission": "identity:tokens-issue",
          "transactional": true
        },
        {
          "name": "Identity.listTokens",
          "permission": "identity:tokens-read",
          "readOnly": true
        },
        {
          "name": "Identity.recordTokenUse",
          "permission": "identity:tokens-use",
          "transactional": true
        },
        {
          "name": "Identity.revokeToken",
          "permission": "identity:tokens-revoke",
          "transactional": true,
          "destructive": true,
          "needsApproval": true
        },
        {
          "name": "Identity.signIn",
          "permission": "identity:sign-in",
          "transactional": true
        },
        {
          "name": "Identity.signUp",
          "permission": "identity:create",
          "transactional": true
        }
      ]
    },
    {
      "name": "my-bookings",
      "service": "@example/api/read-models/my-bookings/MyBookings",
      "kind": "read-model",
      "package": "@example/api",
      "path": "src/read-models/my-bookings",
      "operations": [
        {
          "name": "MyBookings.myBookings",
          "permission": "bookings:read",
          "readOnly": true
        }
      ]
    },
