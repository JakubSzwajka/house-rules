{
  "name": "@example/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:api",
    "build:api": "esbuild src/main.ts --bundle --platform=node --format=esm --external:effect '--external:@effect/*' --outfile=dist/main.js",
    "build:web": "vite build",
    "start": "varlock run --path ../../../../ -- node dist/main.js",
    "dev": "pnpm run \"/^dev:(api|web)$/\"",
    "dev:api": "pnpm run build:api && DEV_ISSUER=1 DATABASE_URL= varlock run --path ../../../../ -- node dist/main.js",
    "dev:web": "varlock run --path ../../../../ -- vite",
    "typecheck": "tsc --project tsconfig.json",
    "test": "varlock run --path ../../../../ -- vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@effect/sql-pg": "4.0.3",
    "@example/bookings": "workspace:0.0.0",
    "@example/dev-sign-in": "workspace:0.0.0",
    "@house-rules/application": "workspace:0.2.0",
    "@house-rules/auth-jwt": "workspace:0.1.0",
    "@house-rules/call-audit": "workspace:0.7.0",
    "@house-rules/comments": "workspace:0.2.0",
    "@house-rules/domain": "workspace:0.1.0",
    "@house-rules/identity": "workspace:0.1.0",
    "@house-rules/migrations": "workspace:0.3.0",
    "@house-rules/node-host": "workspace:0.2.0",
    "@house-rules/party": "workspace:0.1.0",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
